      <aliases enabled='yes' />
      <column caption='Average Yield (tn/ha)' datatype='real' name='[AreaHarvested_ha]' role='measure' type='quantitative' />
      <column caption='Estimated Area (ha)' datatype='real' name='[Calculation_225742948387852288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Production_tons] / [AreaHarvested_ha]' />
      </column>
      <column caption='Yield Comparison Summary' datatype='string' name='[Calculation_926052690823540736]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Yield Efficiency Comparison 2012-2022&quot; + &#13;&#10;CHAR(10) + CHAR(10) +&#13;&#10;&quot;Top Yield Countries:&quot; + CHAR(10) +&#13;&#10;&quot;2012 Avg. Yield: &quot; + &#13;&#10;STR(ROUND(AVG(IF [Year] = 2012 AND [Country] IN (&quot;Netherlands&quot;, &quot;Austria&quot;, &quot;UK&quot;, &quot;Belgium&quot;, &quot;Spain&quot;, &quot;Turkiye&quot;, &quot;China&quot;, &quot;Brazil&quot;, &quot;India&quot;)&#13;&#10;THEN [Yield_tonha] END), 1)) + &quot; tn/ha&quot; + CHAR(10) +&#13;&#10;&quot;2022 Avg. Yield: &quot; + &#13;&#10;STR(ROUND(AVG(IF [Year] = 2022 AND [Country] IN (&quot;Netherlands&quot;, &quot;Austria&quot;, &quot;UK&quot;, &quot;Belgium&quot;, &quot;Spain&quot;, &quot;Turkiye&quot;, &quot;China&quot;, &quot;Brazil&quot;, &quot;India&quot;)&#13;&#10;THEN [Yield_tonha] END), 1)) + &quot; tn/ha&quot; + CHAR(10) +&#13;&#10;&quot;Increase: &quot; + &#13;&#10;STR(ROUND(&#13;&#10;    (AVG(IF [Year] = 2022 AND [Country] IN (&quot;Netherlands&quot;, &quot;Austria&quot;, &quot;UK&quot;, &quot;Belgium&quot;, &quot;Spain&quot;, &quot;Turkiye&quot;, &quot;China&quot;, &quot;Brazil&quot;, &quot;India&quot;)&#13;&#10;    THEN [Yield_tonha] END) &#13;&#10;    - AVG(IF [Year] = 2012 AND [Country] IN (&quot;Netherlands&quot;, &quot;Austria&quot;, &quot;UK&quot;, &quot;Belgium&quot;, &quot;Spain&quot;, &quot;Turkiye&quot;, &quot;China&quot;, &quot;Brazil&quot;, &quot;India&quot;)&#13;&#10;    THEN [Yield_tonha] END)) &#13;&#10;    / AVG(IF [Year] = 2012 AND [Country] IN (&quot;Netherlands&quot;, &quot;Austria&quot;, &quot;UK&quot;, &quot;Belgium&quot;, &quot;Spain&quot;, &quot;Turkiye&quot;, &quot;China&quot;, &quot;Brazil&quot;, &quot;India&quot;)&#13;&#10;    THEN [Yield_tonha] END) * 100, 1)) + &quot;%&quot; +&#13;&#10;CHAR(10) + CHAR(10) +&#13;&#10;&quot;Global Avg.:&quot; + CHAR(10) +&#13;&#10;&quot;2012 Avg. Yield: &quot; + &#13;&#10;STR(ROUND(AVG(IF [Year] = 2012 THEN [Yield_tonha] END), 1)) + &quot; tn/ha&quot; + CHAR(10) +&#13;&#10;&quot;2022 Avg. Yield: &quot; + &#13;&#10;STR(ROUND(AVG(IF [Year] = 2022 THEN [Yield_tonha] END), 1)) + &quot; tn/ha&quot; + CHAR(10) +&#13;&#10;&quot;Increase: &quot; + &#13;&#10;STR(ROUND(&#13;&#10;    (AVG(IF [Year] = 2022 THEN [Yield_tonha] END) &#13;&#10;    - AVG(IF [Year] = 2012 THEN [Yield_tonha] END)) &#13;&#10;    / AVG(IF [Year] = 2012 THEN [Yield_tonha] END) * 100, 1)) + &quot;%&quot; +&#13;&#10;CHAR(10) + CHAR(10) +&#13;&#10;&quot;Top producers have improved yield faster than the global average, widening the efficiency gap. The area considered is the cultivated area, not the total country area.&quot; + CHAR(10) +&#13;&#10;&quot;Source: FAO&quot;' />
      </column>
